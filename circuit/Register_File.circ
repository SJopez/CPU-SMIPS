    <comp lib="8" loc="(100,60)" name="Text">
      <a name="text" val="Register_File: 32 registros de 32 bits, 2 lecturas combinacionales, 1 escritura en flanco de subida de CLK"/>
    </comp>
    <comp lib="8" loc="(100,80)" name="Text">
      <a name="text" val="Reset asíncrono: el clear de cada Register deja 0; $gp y $sp guardan (valor XOR constante)"/>
    </comp>
    <comp lib="8" loc="(1240,1510)" name="Text">
      <a name="text" val="$gp ($28) y $sp ($29): el registro guarda (valor XOR constante). El clear lo deja en 0 y la lectura (Q XOR constante) devuelve"/>
    </comp>
    <comp lib="8" loc="(1240,1530)" name="Text">
      <a name="text" val="la constante de reset: $gp = 0x1800, $sp = 0x3FFC. Para cualquier otro valor la doble XOR se cancela."/>
    </comp>
    <comp lib="8" loc="(1468,122)" name="Text">
      <a name="text" val="Registros $1..$27, $30 y $31: Register de 32 bits; D = WriteData; clock directo a CLK; clear asíncrono = RESET"/>
    </comp>
    <comp lib="8" loc="(2470,100)" name="Text">
      <a name="text" val="La entrada 0 es la constante 0, así $zero siempre lee 0 y escribir en él no tiene efecto."/>
    </comp>
    <comp lib="8" loc="(2470,80)" name="Text">
      <a name="text" val="LECTURA combinacional: 2 multiplexores 32→1 de 32 bits (select = ReadReg1 / ReadReg2)."/>
    </comp>
    <comp lib="8" loc="(255,1025)" name="Text">
      <a name="text" val="Constante 0: entrada ($zero)"/>
    </comp>
    <comp lib="8" loc="(315,535)" name="Text">
      <a name="text" val="ESCRITURA: decodificador 5→32 sobre WriteReg, con enable = RegWrite"/>
    </comp>
    <comp lib="8" loc="(315,555)" name="Text">
      <a name="text" val="La salida k (WEk) habilita el registro k. La salida 0 no se usa ($zero no se escribe)"/>
    </comp>
