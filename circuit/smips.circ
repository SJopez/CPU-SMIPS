      <a name="text" val="Register File"/>
    </comp>
    <comp lib="7" loc="(1390,190)" name="Text">
      <a name="font" val="SansSerif bolditalic 24"/>
      <a name="text" val="32 registros de 32 bits + reset asincrono"/>
    </comp>
    <comp lib="7" loc="(2435,190)" name="Text">
      <a name="text" val="LECTURA combinacional: 2 multiplexores 32→1 de 32 bits (select = ReadReg1 / ReadReg2)."/>
    </comp>
    <comp lib="7" loc="(2435,210)" name="Text">
      <a name="text" val="La entrada 0 es la constante 0, así $zero siempre lee 0 y escribir en él no tiene efecto."/>
    </comp>
    <comp lib="7" loc="(320,365)" name="Text">
      <a name="text" val="INPUTS"/>
    </comp>
    <comp lib="7" loc="(390,1020)" name="Text">
      <a name="text" val="Reset con XOR"/>
    </comp>
    <comp lib="7" loc="(405,1040)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Si el reset se activa se prduce 0 XOR C28/29, que es C28/29"/>
    </comp>
    <comp lib="7" loc="(405,1060)" name="Text">
      <a name="font" val="SansSerif plain 12"/>
      <a name="text" val="Si se escribe en estos registros se produce (D XOR C28/29) XOR C28/29 que es D"/>
    </comp>
    <comp lib="7" loc="(905,1005)" name="Text">
      <a name="text" val="$zero"/>
    </comp>
